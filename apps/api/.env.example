# Copy this file to apps/api/.env for local development.
# Never commit real secrets.

HELIX_ENV=local
HELIX_API_HOST=0.0.0.0
HELIX_API_PORT=8001
DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix
CORS_ORIGINS=http://localhost:3000

# Authentication
HELIX_AUTH_MODE=dev
HELIX_AUTH_ISSUER=
HELIX_AUTH_AUDIENCE=
HELIX_AUTH_JWKS_URL=

# Generation model (Sprint 3+)
HELIX_MODEL_PROVIDER=mock
HELIX_MODEL_MAX_OUTPUT_TOKENS=800
HELIX_MODEL_HISTORY_LIMIT=20
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Baseline RAG (Sprint 4)
# Local defaults make the full pipeline work without Azure.
HELIX_EMBEDDING_PROVIDER=mock
HELIX_RAG_STORAGE_PROVIDER=local
HELIX_RAG_SEARCH_PROVIDER=local
HELIX_EMBEDDING_DIMENSIONS=64
HELIX_CHUNK_SIZE=1200
HELIX_CHUNK_OVERLAP=200
HELIX_RAG_TOP_K=5
HELIX_DOCUMENT_MAX_BYTES=5000000
HELIX_LOCAL_RAG_PATH=.helix

# Set these when switching the matching RAG providers to Azure.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=helix-knowledge
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=helix-knowledge

# Later sprints
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
