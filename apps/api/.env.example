# Copy this file to apps/api/.env for local development.
# Never commit real secrets.

HELIX_ENV=local
HELIX_API_HOST=0.0.0.0
HELIX_API_PORT=8000
DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix
CORS_ORIGINS=http://localhost:3000

# Authentication
# dev: local-only X-Helix-* headers; jwt: validate a real Bearer token.
HELIX_AUTH_MODE=dev
HELIX_AUTH_ISSUER=
HELIX_AUTH_AUDIENCE=
HELIX_AUTH_JWKS_URL=

# Azure / models (used in later sprints)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
