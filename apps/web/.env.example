# Copy this file to apps/web/.env.local for local development.
# The browser talks to the FastAPI application on port 8001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Local authentication adapter.
# Production uses a real identity provider and Bearer token; these values are local-only.
NEXT_PUBLIC_HELIX_AUTH_MODE=dev
NEXT_PUBLIC_HELIX_DEV_SUBJECT=dev-user
NEXT_PUBLIC_HELIX_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
NEXT_PUBLIC_HELIX_DEV_EMAIL=dev@helix.local
NEXT_PUBLIC_HELIX_DEV_NAME=Helix Developer
