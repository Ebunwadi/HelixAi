# Copy this file to .env and fill in local values.
# Never commit .env or real secrets.

# --- API ---
HELIX_ENV=local
HELIX_API_HOST=0.0.0.0
HELIX_API_PORT=8000

# Matches docker-compose.yml. Change only if your local Postgres differs.
DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Azure / models (not required for Sprint 1) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
